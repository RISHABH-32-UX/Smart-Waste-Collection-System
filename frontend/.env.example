# CleanCity Frontend Environment Configuration
#
# Backend API Base URL (defaults to http://localhost:8080/api/v1)
# NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
#
# Development-Only UI Preview Mode (Bypasses auth and uses local mock data)
# NOTE: This has NO effect in production builds (NODE_ENV=production).
# NEXT_PUBLIC_DEV_AUTH_BYPASS=true
# DEV_AUTH_BYPASS=true

